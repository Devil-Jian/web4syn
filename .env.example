# REQUIRED: at least 12 characters. Used only to initialize the RCT admin account.
# Change passwords through an authorized account procedure if one already exists in rct.sqlite.
WEB4SYN_RCT_ADMIN_PASSWORD=

# Linux paths. Both must exist and be accessible to container uid 10001.
WEB4SYN_DATA_PATH=/var/lib/web4syn
WEB4SYN_PACKS_PATH=/dataset/RCTs/data_h5_v2

# Off by default: legacy v1 routes are anonymously accessible and NOT suitable for production.
WEB4SYN_ENABLE_LEGACY_DEMO=0
